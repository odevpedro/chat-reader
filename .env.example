# Chat Reader for Kindle — copie para .env e preencha.
#   cp .env.example .env
# NUNCA comite o .env (ele esta no .gitignore).

# --- Backend / PostgreSQL -------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatreader
POSTGRES_USER=chatreader
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=10

# --- Servidor --------------------------------------------------------------
SERVER_PORT=8080

# --- Segurança (usuário único do MVP) -------------------------------------
# Autenticação ligada por padrão. Em desenvolvimento você PODE desligar, mas
# nunca exponha a API sem auth em rede.
AUTH_ENABLED=true
CHAT_READER_USERNAME=reader

# Hash BCrypt da sua senha. Gere (não use a senha em texto puro):
#   ./scripts/hash-password.sh 'sua-senha'
# IMPORTANTE: envolva o valor em aspas simples. O Compose interpola "$" e
# corromperia o hash ($2y$10$...) se ele ficasse sem aspas.
CHAT_READER_PASSWORD_HASH='change-me'

# Segredo HS256. Deve ter ao menos 32 caracteres. Gere com:
#   openssl rand -base64 48
# Também use aspas simples: base64 contém "$", "+", "/" e "=".
JWT_SECRET='change-me'
JWT_EXPIRATION_DAYS=30

# --- Importação ------------------------------------------------------------
# Limite de payload e de conteúdo aceitos na importação.
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_CHATS=10000
IMPORT_MAX_MESSAGES_PER_CHAT=5000
